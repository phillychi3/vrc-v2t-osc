{
	"name": "vrc2t",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "build/electron/main.cjs",
	"packageManager": "pnpm@11.26.0",
	"scripts": {
		"version:sync": "python scripts/sync-version.py",
		"version:check": "python scripts/sync-version.py --check",
		"dev": "pnpm run version:sync && concurrently -k -n renderer,electron -c cyan,magenta \"vite dev\" \"pnpm run build:electron && wait-on -t 100000 http-get://127.0.0.1:5173/ && electron .\"",
		"build": "pnpm run version:sync && vite build && pnpm run build:electron",
		"build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
		"build:electron": "vite build --config vite.electron.config.ts && vite build --config vite.preload.config.ts",
		"dist": "pnpm run build && pnpm run build:backend && electron-builder",
		"test:packaged-backend": "poetry run python scripts/smoke-packaged-backend.py build/python/vrc-v2t-backend/vrc-v2t-backend.exe",
		"test:packaged-renderer": "node scripts/smoke-packaged-renderer.mjs \"release/win-unpacked/VRC2T.exe\"",
		"preview": "vite preview",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo",
		"typecheck:watch": "svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:node": "node --experimental-strip-types --test tests/*.test.mjs",
		"test:renderer": "node scripts/test-renderer.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/carbon": "^1.2.26",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@unocss/reset": "^66.10.0",
		"concurrently": "^10.0.5",
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3",
		"electron-serve": "^3.0.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"unocss": "^66.10.0",
		"vite": "^8.2.2",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"@iconify-svelte/material-symbols": "^1.0.49",
		"@ikun-ui/core": "^0.2.8",
		"@ikun-ui/preset": "^0.2.8",
		"@ikun-ui/select": "^0.2.8",
		"@ikun-ui/switch": "^0.2.8"
	}
}
